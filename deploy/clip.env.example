# clip 环境变量示例
# 复制到 /etc/clip/clip.env 后按需修改，权限建议 600

CLIP_HOST=0.0.0.0
CLIP_PORT=8080

# 数据目录（与旧 Python 版保持相同的 CLIP_FILE / CLIP_STORE 即可直接沿用旧数据）
CLIP_FILE=/opt/clip/data/clip.txt
CLIP_STORE=/opt/clip/data/clip.txt.files
CLIP_DB=/opt/clip/data/clip.txt.files/.meta/clip.db
# 旧长期链接快照目录（仅兼容读取已有 /d/<token>，可不设）
CLIP_SHARE_DIR=/opt/clip/data/clip.txt.files/.shares

# 保留时间：默认 1 天；0 = 不过期
CLIP_TTL=86400
CLIP_MAX_BYTES=2097152
CLIP_MAX_BINARY=10485760
CLIP_ONCE=0

# 反向代理：记录真实客户端 IP
CLIP_TRUST_PROXY=1
# 额外可信代理 IP（逗号分隔）；Nginx 从 127.0.0.1 反代时无需填写
CLIP_TRUSTED_PROXIES=

# 内容访问令牌（可选，留空则公开）
CLIP_TOKEN=

# 后台
CLIP_ADMIN_PATH=/admin
# 务必修改；留空则后台公开访问
CLIP_ADMIN_PASSWORD=change-me
